# Tokslearn — environment variables
# Copy to apps/web/.env.local for local dev. Validated at boot by apps/web/env.ts (@t3-oss/env-nextjs).
# Set per environment in Vercel (Development / Preview / Production). Never commit real values.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets in them.
# Explanations and owners: docs/22-environment.md

# ── App ────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local                      # local | preview | staging | production
APP_VERSION=dev                                # set by CI to git sha

# ── Database (Neon) ────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host-pooler.eu-central-1.aws.neon.tech/tokslearn?sslmode=require   # pooled, app traffic
DATABASE_URL_DIRECT=postgresql://user:pass@host.eu-central-1.aws.neon.tech/tokslearn?sslmode=require   # direct, migrations only
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tokslearn_test

# ── Redis (Upstash) ────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Auth (Better Auth) ─────────────────────────────────
BETTER_AUTH_SECRET=                            # 32+ random bytes (openssl rand -base64 32)
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments (Paystack) ────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx                # also used to verify webhook signatures
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ── KYC (Dojah) ────────────────────────────────────────
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://sandbox.dojah.io        # production: https://api.dojah.io
DOJAH_WEBHOOK_SECRET=
NEXT_PUBLIC_DOJAH_WIDGET_ID=

# ── Video (Bunny Stream) ───────────────────────────────
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=                          # library API key (server only)
BUNNY_STREAM_TOKEN_AUTH_KEY=                   # for signed embed/HLS URLs
BUNNY_STREAM_CDN_HOSTNAME=                     # vz-xxxx.b-cdn.net
BUNNY_WEBHOOK_SECRET=

# ── Live (Daily) ───────────────────────────────────────
DAILY_API_KEY=
DAILY_DOMAIN=tokslearn.daily.co
DAILY_WEBHOOK_SECRET=

# ── Files (Cloudflare R2) ──────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=tokslearn-public
R2_BUCKET_PRIVATE=tokslearn-private
NEXT_PUBLIC_CDN_URL=https://cdn.tokslearn.com  # custom domain on the public bucket

# ── Jobs (Inngest) ─────────────────────────────────────
INNGEST_EVENT_KEY=                             # not needed with local Dev Server
INNGEST_SIGNING_KEY=
INNGEST_DEV=1                                  # local only

# ── Email (Resend) ─────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Tokslearn <hello@mail.tokslearn.com>"
EMAIL_REPLY_TO=support@tokslearn.com
SUPPORT_EMAIL=support@tokslearn.com
FINANCE_ALERT_EMAIL=finance@tokslearn.com

# ── Observability & analytics ──────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                             # CI only, for source maps
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Security ───────────────────────────────────────────
IP_HASH_SALT=                                  # rotate monthly; used to hash IPs in evidence tables
CRON_ADMIN_TOKEN=                              # protects manual trigger endpoints (if any)
