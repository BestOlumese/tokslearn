{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies", ":semanticCommits"],
  "timezone": "Africa/Lagos",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 9am on monday"] },
  "packageRules": [
    {
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "babel-plugin-react-compiler"
      ],
      "groupName": "next and react"
    },
    { "matchPackageNames": ["@orpc/**"], "groupName": "orpc" },
    {
      "matchPackageNames": [
        "drizzle-orm",
        "drizzle-kit",
        "@neondatabase/serverless",
        "pg",
        "@types/pg"
      ],
      "groupName": "database"
    },
    { "matchPackageNames": ["@tanstack/**"], "groupName": "tanstack" },
    { "matchPackageNames": ["@sentry/**"], "groupName": "sentry" },
    { "matchPackageNames": ["radix-ui", "lucide-react", "sonner"], "groupName": "ui primitives" },
    {
      "matchPackageNames": [
        "vitest",
        "vite",
        "@playwright/test",
        "@biomejs/biome",
        "turbo",
        "tsup",
        "tsx"
      ],
      "groupName": "tooling"
    },
    {
      "matchPackageNames": ["@orpc/**"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "oRPC v2 needs an ADR first (ADR-010)"
    },
    {
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "TypeScript 7 needs an ADR first (ADR-021)"
    },
    { "matchUpdateTypes": ["major"], "dependencyDashboardApproval": true }
  ]
}
