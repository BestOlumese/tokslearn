{
  "name": "@tokslearn/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./kernel": "./src/kernel/index.ts",
    "./admin": "./src/admin/index.ts",
    "./analytics": "./src/analytics/index.ts",
    "./assessments": "./src/assessments/index.ts",
    "./assignments": "./src/assignments/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./commerce": "./src/commerce/index.ts",
    "./courses": "./src/courses/index.ts",
    "./engagement": "./src/engagement/index.ts",
    "./enrollments": "./src/enrollments/index.ts",
    "./fixtures": "./src/testing/index.ts",
    "./identity": "./src/identity/index.ts",
    "./instructors": "./src/instructors/index.ts",
    "./learning": "./src/learning/index.ts",
    "./live": "./src/live/index.ts",
    "./ledger": "./src/ledger/index.ts",
    "./media": "./src/media/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./testing": "./src/kernel/testing.ts",
    "./certificates": "./src/certificates/index.ts",
    "./cohorts": "./src/cohorts/index.ts",
    "./community": "./src/community/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "seed:demo-catalog": "tsx --conditions=react-server src/scripts/seed-demo-catalog.ts",
    "seed:demo-assessments": "tsx --conditions=react-server src/scripts/seed-demo-assessments.ts",
    "seed:load-exam": "tsx --conditions=react-server src/scripts/seed-load-exam.ts",
    "seed:demo-cohorts": "tsx --conditions=react-server src/scripts/seed-demo-cohorts.ts",
    "seed:demo-community": "tsx --conditions=react-server src/scripts/seed-demo-community.ts",
    "reindex:catalog": "tsx --conditions=react-server src/scripts/reindex-catalog.ts",
    "test:money": "vitest run --coverage --coverage.provider=v8 --coverage.include=src/kernel/money.ts --coverage.include='src/ledger/**' --coverage.include='src/commerce/**' --coverage.include='src/enrollments/**' --coverage.exclude='**/*.test.ts' --coverage.exclude='**/index.ts' --coverage.thresholds.lines=95 --coverage.thresholds.functions=95 --coverage.reporter=text-summary",
    "seed:demo-live": "tsx --conditions=react-server src/scripts/seed-demo-live.ts",
    "daily:webhook": "tsx --env-file-if-exists=../../.env --conditions=react-server src/scripts/daily-webhook.ts"
  },
  "dependencies": {
    "@tokslearn/contract": "workspace:*",
    "@tokslearn/db": "workspace:*",
    "@tokslearn/emails": "workspace:*",
    "@tokslearn/integrations": "workspace:*",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@tokslearn/config": "workspace:*",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
